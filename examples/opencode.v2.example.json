{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "kondash": {
      "name": "KONDash",
      "package": "@opencode/ai/providers/openai-compatible/responses",
      "settings": {
        "baseURL": "http://127.0.0.1:8317/v1",
        "apiKey": "{file:/absolute/path/to/cliproxyapi/proxy-key}"
      },
      "models": {
        "<deployment-id>": {
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    }
  }
}
